"similar to a high-quality scan."
msgstr ""
"Gör texten mörkare och bakgrunden ljusare, vilket ger ett renare resultat "
"liknande en skanning av hög kvalitet."

#: src/bigocrpdf/ui/corrections_dialog.py:69
msgid "Enhance Embedded Images"
msgstr "Förbättra inbäddade bilder"

#: src/bigocrpdf/ui/corrections_dialog.py:71
