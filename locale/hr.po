#: src/bigocrpdf/ui/pdf_editor/editor_help_controller.py:84
msgid ""
"Use the PDF editor to view and organize your documents. You can rearrange, "
"rotate, or remove pages, compress files, and split documents by pages or "
"file size."
msgstr ""
"Koristite PDF uređivač za pregled i organizaciju dokumenata. Možete "
"preurediti, rotirati ili ukloniti stranice, komprimirati datoteke i "
"podijeliti dokumente po stranicama ili veličini."

