msgid "Straighten Pages"
msgstr "Sirgeneda lehekülgi"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 48
#: src/bigocrpdf/ui/corrections_dialog.py:26
msgid "Fixes pages that were scanned at a slight angle. The text lines become perfectly horizontal."
msgstr "Parandab kergelt viltuselt skannitud leheküljed. Tekstitread muutuvad täiuslikult horisontaalseks."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 55
#: src/bigocrpdf/ui/corrections_dialog.py:33
msgid "Fix Curved Text"
msgstr "Paranda kõverat teksti"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 57
#: src/bigocrpdf/ui/corrections_dialog.py:35
msgid "Corrects wavy or curved text that appears when photographing a book or a bent document."
msgstr "Parandab lainelise või kõvera teksti, mis tekib raamatut või painutatud dokumenti pildistades."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 64
#: src/bigocrpdf/ui/corrections_dialog.py:42
msgid "Fix Perspective"
msgstr "Paranda perspektiiv"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 66
#: src/bigocrpdf/ui/corrections_dialog.py:44
msgid ""
"Corrects pages that look like a trapezoid because the photo was taken at an angle instead of "
"straight above."
msgstr "Parandab leheküljed, mis näevad välja nagu trapets, kuna foto tehti nurga alt, mitte otse ülevalt."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 73
#: src/bigocrpdf/ui/corrections_dialog.py:51
msgid "Fix Page Direction"
msgstr "Paranda lehekülje suund"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 75
#: src/bigocrpdf/ui/corrections_dialog.py:53
msgid ""
"Detects and fixes pages that are upside-down or sideways, automatically rotating them to the "
"correct orientation."
msgstr ""
"Tuvastab ja parandab tagurpidi või külili olevad leheküljed, pöörates need automaatselt õigesse "
"suunda."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 82
#: src/bigocrpdf/ui/corrections_dialog.py:60
msgid "Enhance Readability"
msgstr "Paranda loetavust"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 84
#: src/bigocrpdf/ui/corrections_dialog.py:62
msgid ""
"Makes text darker and the background lighter, producing a cleaner result similar to a high-quality "
"scan."
msgstr ""
"Muudab teksti tumedamaks ja tausta heledamaks, andes puhtama tulemuse, mis sarnaneb kvaliteetse "
"skaneeringuga."
# #-#-#-#-#  bigocrpdf.pot (bigocrpdf)  #-#-#-#-#
# 
