#: src/bigocrpdf/ui/corrections_dialog.py:42
msgid "Fix Perspective"
msgstr "Laga sjónarhorn"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 66
#: src/bigocrpdf/ui/corrections_dialog.py:44
msgid ""
"Corrects pages that look like a trapezoid because the photo was taken at an angle instead of "
"straight above."
msgstr "Lagar síður sem líta út eins og trapisa vegna þess að myndin var tekin á halla í stað beint ofan."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 73
#: src/bigocrpdf/ui/corrections_dialog.py:51
msgid "Fix Page Direction"
msgstr "Laga síðustefnu"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 75
#: src/bigocrpdf/ui/corrections_dialog.py:53
msgid ""
"Detects and fixes pages that are upside-down or sideways, automatically rotating them to the "
"correct orientation."
msgstr "Greinir og lagar síður sem eru á hvolfi eða á hliðinni, og snýr þeim sjálfvirkt á réttan hátt."
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 82
#: src/bigocrpdf/ui/corrections_dialog.py:60
msgid "Enhance Readability"
msgstr "Bæta læsileika"
# File: bigocrpdf/src/bigocrpdf/ui/corrections_dialog.py, line: 84
#: src/bigocrpdf/ui/corrections_dialog.py:62
msgid ""
"Makes text darker and the background lighter, producing a cleaner result similar to a high-quality "
"scan."
msgstr "Gerir texta dekkri og bakgrunn ljósari og gefur hreinlegri niðurstöðu líkt og hágæða skönnun."
